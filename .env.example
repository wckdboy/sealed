# Sealed API — example environment. Copy to /etc/vault/env on the host
# (mode 0640, root-owned, NOT in the same backup as the database).

# Listen address. Behind Bunny, bind to the private interface only.
VAULT_BIND=127.0.0.1:8080

# Storage
DATABASE_URL=sqlite:/var/lib/vault/vault.db
VAULT_BLOB_DIR=/var/lib/vault/blobs

# Secrets — OPTIONAL. Leave blank and the first boot generates all three into
# VAULT_SECRET_DIR (0600) and reuses them forever. Set them only if you manage
# secrets externally (a vault, a sealed env file, Coolify's SERVICE_PASSWORD_64_*).
# Never paste placeholders: values that are all-identical or low-entropy are
# rejected at boot.
#
# Formats: 64+ hex characters are decoded to bytes; anything else is used as raw
# UTF-8 (so a 64-character alphanumeric secret-manager value works as-is). The
# portal key must end up exactly 32 bytes — longer material is derived with
# vault/portal-key/v1, and /healthz reports "derived": true.
#
#   pepper   login verifier HMAC key   lost = every account must re-enrol
#   signing  blob URL signing key      lost = outstanding URLs 403
#   portal   PKEK for public content   lost = public playback breaks
VAULT_SECRET_DIR=/var/lib/vault/secrets
VAULT_AUTO_SECRETS=1
# VAULT_PEPPER=
# VAULT_SIGNING=
# VAULT_PORTAL_KEY=

# The app refuses to start if the database has accounts but the secrets are new
# (a lost secrets volume), or if the pepper fingerprint does not match the one the
# database was created with. This flag is the only way past those refusals, and it
# also unlocks deliberately unsafe settings. Use it only on a throwaway instance.
VAULT_ALLOW_UNSAFE=0

# Trust & safety. Empty contact prints "NOT CONFIGURED" on /dmca.
VAULT_DMCA_CONTACT=dmca@example.invalid
# name=path pairs, comma separated. The service refuses to start on a bad file,
# and warns loudly if this is empty (which means no screening at all).
VAULT_HASH_LISTS=

# CDN / proxy behaviour
# Blob Cache-Control max-age (and CDN s-maxage). Also the worst-case window a
# quarantined file is still served from an edge cache, so keep it short.
VAULT_BLOB_CACHE_SECONDS=3600
# Trust the first hop of X-Forwarded-For. Enable behind Bunny/Traefik only:
# Bunny replaces the header with the real visitor IP, so the rate limiter keys on
# the true client. Never enable it when the origin is directly exposed.
VAULT_TRUST_PROXY=1
# Optional: require this header on /v1/blobs/*, so direct hits on the origin are
# refused even if the firewall allowlist is wrong. Set the same value in the CDN's
# origin request headers.
# VAULT_ORIGIN_SECRET=
# Set to 0 only for load tests.
VAULT_RATE_LIMIT=1

# Operator panel (/v1/admin/*, /#admin in the web client). Unset disables it entirely.
# openssl rand -base64 36
# VAULT_ADMIN_TOKEN=

# Accounts
VAULT_DEFAULT_TIER=basic
VAULT_SESSION_TTL=2592000
VAULT_MAX_UPLOAD=20000000000

# Web origins allowed to call the API (comma separated).
VAULT_ALLOWED_ORIGINS=https://vault.example.com

# NEVER set this in production: it generates ephemeral secrets and relaxes defaults.
# VAULT_DEV=1

# Log level for tracing-subscriber.
RUST_LOG=info,tower_http=warn
